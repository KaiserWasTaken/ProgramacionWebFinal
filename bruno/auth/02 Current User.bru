meta {
  name: Current User
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/auth/me
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("token authenticates the seeded user", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().email).to.equal(bru.getEnvVar("userEmail"));
    expect(res.getBody().role).to.equal("USER");
  });
}
