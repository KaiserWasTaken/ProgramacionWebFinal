meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200) {
    bru.setVar("token", body.accessToken);
  }
}

tests {
  test("login returns a bearer token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().accessToken).to.be.a("string");
    expect(res.getBody().accessToken.length).to.be.greaterThan(0);
    expect(res.getBody().tokenType).to.equal("Bearer");
  });
}
